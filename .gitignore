# Build output. Regenerated by `python check/build.py`; never edited by hand,
# never committed, so that two chats building the same subject do not collide
# on files neither of them wrote.
check/_build/
books/*/_build/

# Compression working files. Pass 1 and the gap report are intermediate: only
# the restored section and the DEFECTS.md entries it produced are kept.
books/*/compress/*-pass1.md
books/*/compress/*-gaps.md

__pycache__/
*.pyc
.DS_Store
.tectonic-cache/
